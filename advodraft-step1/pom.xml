<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 
    ═══════════════════════════════════════════════════════════════════
    WHAT IS THIS FILE?
    ═══════════════════════════════════════════════════════════════════
    pom.xml = Project Object Model
    - Tells Maven what your project needs
    - Like package.json in Node.js or requirements.txt in Python
    - Maven downloads all dependencies automatically
    
    INTERVIEW: "pom.xml defines project dependencies and build configuration"
    ═══════════════════════════════════════════════════════════════════
    -->

    <!-- Spring Boot parent - provides dependency versions -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
    </parent>

    <!-- Project coordinates (unique identifier) -->
    <groupId>com.advodraft</groupId>
    <artifactId>advodraft-backend</artifactId>
    <version>1.0.0</version>
    <name>Advodraft Backend</name>

    <!-- Java version -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 
        ═══════════════════════════════════════════════════════════════
        SPRING BOOT WEB STARTER
        ═══════════════════════════════════════════════════════════════
        What it includes:
        - Spring MVC (for REST APIs)
        - Tomcat (embedded web server)
        - Jackson (converts Java objects to JSON)
        
        WHY: Build REST APIs, handle HTTP requests
        ═══════════════════════════════════════════════════════════════
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin - to run the app -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
